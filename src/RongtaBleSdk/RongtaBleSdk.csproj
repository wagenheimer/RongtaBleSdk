<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Building a *library* (not an app) for iOS/MacCatalyst does not require a Mac/Xcode — only
         the workload's reference assemblies, which install on any OS. CI therefore builds and packs
         these TFMs on a Windows runner (see .github/workflows/publish.yml). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RongtaBleSdk</RootNamespace>

    <PackageId>RongtaBleSdk</PackageId>
    <Authors>Cezar Wagenheimer</Authors>
    <Description>Unofficial .NET MAUI SDK for Rongta label printers (tested on the RPP30) over Bluetooth Low Energy, using Shiny.BluetoothLE and CPCL commands.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>rongta;rpp30;ble;bluetooth;label-printer;cpcl;maui;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/wagenheimer/RongtaBleSdk</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wagenheimer/RongtaBleSdk</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.BluetoothLE" Version="4.0.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
